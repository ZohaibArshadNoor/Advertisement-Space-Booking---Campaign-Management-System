# -----------------------------------------------------------------------------
# Advertisement Booking System - Environment Configuration Template
# Copy this file to .env and replace placeholder values with real secrets.
# NEVER commit your actual .env file to version control!
# -----------------------------------------------------------------------------

# Flask & WSGI Environment (development | testing | production)
FLASK_ENV=production
FLASK_APP=wsgi.py

# Cryptographic Keys (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-secure-random-64-char-secret-key
JWT_SECRET_KEY=replace-with-a-secure-random-64-char-jwt-key
JWT_ACCESS_TOKEN_EXPIRES_HOURS=8

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://db_user:db_password@localhost:5432/adbooking_prod

# Media & File Storage Settings
UPLOAD_FOLDER=uploads/creatives
MAX_CONTENT_LENGTH=52428800

# CORS Whitelist (Comma-separated trusted frontend domains)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-domain.com
